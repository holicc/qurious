statement ok
create table fx(a int, b int, s varchar, padded varchar);

statement ok
insert into fx values (1, 10, 'Hello', '  Hello  '), (NULL, 20, 'wörld', 'wörld'), (3, NULL, NULL, NULL);

# COALESCE takes the first argument that is not NULL. A mix of argument types is widened rather
# than rejected: `coalesce(int_col, 0)` is the common case.
query I
select coalesce(a, b, 0) from fx;
----
1
20
3

query I
select coalesce(a, b) from fx;
----
1
20
3

query I
select coalesce(a) from fx;
----
1
NULL
3

# NULLIF yields NULL when the two are equal, and keeps the first argument's own type
query II
select nullif(a, 1), nullif(b, 20) from fx;
----
NULL 10
NULL NULL
3 NULL

query T
select upper(s) from fx;
----
HELLO
WÖRLD
NULL

query T
select lower(s) from fx;
----
hello
wörld
NULL

# Case conversion is full Unicode, as in postgres. sqlite only folds ASCII and would leave `ö`.
query T
select upper('wörld');
----
WÖRLD

# trim is measured through length so the expected values carry no significant whitespace
query IIII
select length(padded), length(trim(padded)), length(ltrim(padded)), length(rtrim(padded)) from fx where a = 1;
----
9 5 7 7

# LENGTH counts characters, not bytes: 'wörld' is 5 characters in 6 bytes
query I
select length(s) from fx;
----
5
5
NULL

query I
select char_length(s) from fx;
----
5
5
NULL

# these are usable anywhere an expression is
query T
select s from fx where upper(s) = 'HELLO';
----
Hello

query TI rowsort
select lower(s), count(*) from fx where s is not null group by lower(s);
----
hello 1
wörld 1

# wrong argument types and counts are errors
statement error expects a string argument
select upper(a) from fx;

statement error requires 1 argument
select upper(s, s) from fx;

statement error requires 2 arguments
select nullif(a) from fx;

statement error cannot combine arguments of type
select coalesce(a, s) from fx;

statement ok
create table mx(i int, d double, dec decimal(15,2));

statement ok
insert into mx values (-3, -2.5, -1.25), (0, 0.0, 0.00), (7, 2.5, 3.75), (NULL, NULL, NULL);

# ABS keeps the argument's own type rather than widening to a float, as postgres does. For a
# decimal that also means keeping its precision and scale.
query IRR
select abs(i), abs(d), abs(dec) from mx;
----
3 2.5 1.25
0 0 0
7 2.5 3.75
NULL NULL NULL

query I
select abs(i) + 1 from mx where i = -3;
----
4

# halves round away from zero, as in sqlite and postgres
query RRR
select round(d), ceil(d), floor(d) from mx;
----
-3 -2 -3
0 0 0
3 3 2
NULL NULL NULL

query R
select sqrt(abs(d)) from mx;
----
1.581138830084
0
1.581138830084
NULL

statement error expects a numeric argument
select abs(s) from fx;

statement error requires 1 argument
select round(d, 2) from mx;

# GREATEST and LEAST ignore NULL arguments, as in postgres, so the result is NULL only when every
# argument is. sqlite's scalar max/min return NULL if any argument is.
query II
select greatest(1, 5, 3), least(1, 5, 3);
----
5 1

query II
select greatest(a, b), least(a, b) from fx;
----
10 1
20 20
3 3

query I
select greatest(a) from fx where a is null;
----
NULL

# CONCAT skips NULL arguments rather than propagating them, which is postgres's `concat()` -- and
# deliberately unlike `||`.
query T
select concat(s, '!') from fx;
----
Hello!
wörld!
!

query T
select concat(s) from fx;
----
Hello
wörld
NULL

query T
select concat('a', 1, 'b');
----
a1b

query TT
select reverse('abc'), reverse('wörld');
----
cba dlröw

query T
select replace('a-b-c', '-', '+');
----
a+b+c

# STRPOS counts characters, so the multi-byte case is 3 rather than a byte offset
query III
select strpos('hello world', 'world'), strpos('hello', 'zz'), strpos('wörld', 'rld');
----
7 0 3

query BB
select starts_with('hello', 'he'), starts_with('hello', 'x');
----
true false

query TT
select repeat('ab', 3), repeat('ab', 0);
----
ababab (empty)

# a negative count takes from the far end, as in postgres
query TTTT
select left('abcdef', 3), left('abcdef', -2), right('abcdef', 3), right('abcdef', -2);
----
abc abcd def cdef

query RRR
select power(2, 10), mod(7, 3), mod(-7, 3);
----
1024 1 -1

query RRRR
select ln(1), log10(100), exp(0), log(10, 100);
----
0 2 1 2

query RRR
select sign(-3), sign(0), sign(7);
----
-1 0 1

query RR
select trunc(-2.5), trunc(2.9);
----
-2 2

# Aliases reach the same implementations as the canonical names.
query TTR
select substr('abcdef', 2, 3), btrim('  pad  '), pow(2, 10);
----
bcd pad 1024

statement error requires 2 arguments
select power(2) from mx;

statement error expects a string argument
select reverse(a) from fx;

statement error more than the
select repeat('abcdefghij', 1000000);
