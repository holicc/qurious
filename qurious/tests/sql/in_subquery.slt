statement ok
create table t1(a int, b varchar, c int);

statement ok
create table t2(x int, y varchar);

statement ok
insert into t1 values (1, 'aa', 5), (2, 'bb', 6), (3, 'cc', 7);

statement ok
insert into t2 values (1, 'p'), (3, 'q');

# IN (subquery) becomes a left semi join
query I
select a from t1 where a in (select x from t2) order by a;
----
1
3

# NOT IN (subquery) becomes a left anti join
query I
select a from t1 where a not in (select x from t2) order by a;
----
2

query I
select a from t1 where a in (select x from t2 where y = 'p') order by a;
----
1

query I
select a from t1 where a in (select x from t2 where x <> 3) order by a;
----
1

# nested IN subqueries
query I
select a from t1 where a in (select x from t2 where x in (select a from t1 where a > 2)) order by a;
----
3

# a subquery in the WHERE clause must not swallow the enclosing GROUP BY
query II
select a, sum(c) from t1 where a in (select x from t2) group by a order by a;
----
1 5
3 7

query III rowsort
select a, b, sum(c) from t1 where a in (select x from t2) group by a, b;
----
1 aa 5
3 cc 7

# ... nor the enclosing ORDER BY / LIMIT
query I
select a from t1 where a in (select x from t2) order by a desc limit 1;
----
3

# the same holds for an aggregating subquery
query I
select a from t1 where a in (select x from t2 group by x having count(x) > 0) order by a;
----
1
3

statement error IN subquery must return exactly one column
select a from t1 where a in (select x, y from t2);
