statement ok
create table al(k int, q decimal(15,2));

statement ok
insert into al values (1, 10.50), (1, 20.25), (2, 30.75), (2, 5.00);

# An alias replaces the table name: unqualified columns resolve to the alias, which is what the
# SubqueryAlias node actually produces. Resolving them to the base name instead gave both sides of
# a self-join the same qualifier, leaving them indistinguishable to the optimizer.
query IR
select k, q from al a order by k, q;
----
1 10.50
1 20.25
2 5.00
2 30.75

query IR
select a.k, a.q from al a order by a.k, a.q;
----
1 10.50
1 20.25
2 5.00
2 30.75

# the base table name is out of scope once aliased, like in postgres and sqlite
statement error not found in table
select al.q from al a;

# a correlated scalar subquery over the same table under a different alias
query R
select q from al a where q < (select avg(q) from al b where b.k = a.k) order by q;
----
5.00
10.50

query R
select q from al a where q = (select max(q) from al b where b.k = a.k) order by q;
----
20.25
30.75

# a plain self-join must keep the two sides apart
query RR
select a.q, b.q from al a, al b where a.k = b.k and a.q < b.q order by a.q, b.q;
----
5.00 30.75
10.50 20.25

# the same relation may not be introduced twice under one name
statement error already in scope
select k from al, al;
