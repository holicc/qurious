statement ok
create table u(a int, b varchar);

statement ok
insert into u values (1, 'x');

# Unsupported input has to come back as an error. These all used to be `todo!()` or
# `unimplemented!()`, which aborts the process rather than failing the statement -- under the
# parallel test harness that took every other file's results down with it.

statement error unsupported table function
select * from read_avro('/tmp/x.avro');

statement error Unknown function
select nosuchfunction(a) from u;

statement error aggregate function sum takes exactly one argument
select sum(a, b) from u;

statement error DISTINCT is not supported for SUM
select sum(distinct a) from u;

statement error COPY TO is not supported
copy u to '/tmp/x.csv';

statement error column aliases are only supported on a derived table
select * from u as t (x, y);

statement error IN subquery must return exactly one column
select a from u where a in (select a, b from u);

statement error unexpected token
drop index nope;

# and a plain unsupported statement is an error, not a panic
statement error
explain select * from u;

# UPDATE parses and resolves its target, but the executor does not implement it. The parser used to
# skip registering the target table, so this failed with a misleading "Table Not Found" instead.
statement error Unsupported DML UPDATE
update u set a = 2 where a = 1;

# A bad file path is an argument error, not a reason to bring the process down. `Url::from_file_path`
# used to be unwrapped, and canonicalize's failure is reported with the path that caused it.
statement error file path
select * from read_csv('/definitely/not/here/nope.csv');

statement error
select * from read_parquet('/definitely/not/here/nope.parquet');
